# libembedding CMake package configuration
#
# Auteur: David Orel
# SPDX-License-Identifier: MIT

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT WIN32)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")
    find_dependency(ONNXRuntime)
    if(@LIBEMBEDDING_PACKAGE_REQUIRES_CURL@)
        find_dependency(CURL)
    endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/libembedding-targets.cmake")

    lembed_sparse_best_config
    lembed_image_autotune

    ; ---- llama.cpp backend ----
    lembed_llama_backend_available
    lembed_llama_version

    ; ---- Worker auto-tuning ----
    lembed_detect_optimal_workers
    lembed_recommended_workers_for_model

    ; ---- GGUF model registry ----
    lembed_list_gguf_models
    lembed_find_gguf_model
    lembed_default_gguf_model

    ; ---- Embedding cache ----
    lembed_cache_config_default
    lembed_cache_create
    lembed_cache_free
    lembed_cache_clear
    lembed_cache_get
    lembed_cache_put
    lembed_cache_size
    lembed_cache_capacity

    ; ---- Unified benchmark ----
    lembed_benchmark_run
    lembed_benchmark_autotune
    lembed_benchmark_compare
    lembed_benchmark_get_corpus
    lembed_benchmark_select_model
    lembed_benchmark_detect_sessions
    lembed_benchmark_default_cache_dir

    ; ---- Tuning cache ----
    lembed_cache_detect_hardware
    lembed_cache_detect_software
    lembed_tune_cache_load
    lembed_tune_cache_save
    lembed_tune_cache_clear
    lembed_tune_cache_path
    lembed_tune_cache_key
    lembed_tune_cache_add_config
    lembed_tune_cache_set_best